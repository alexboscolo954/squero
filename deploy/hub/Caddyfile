# The Hub's only public routes: each Contract's Alertmanager, Grafana or PagerDuty posting
# alerts (PagerDuty's by its signature, the others with the Contract's token),
# Relays dialing in (a websocket; the Hub refuses one without a Relay token), and
# Actuators pulling and reporting (the Hub refuses either without an Actuator token).
# Investigations, decisions, metrics and the API docs stay on 127.0.0.1, reached
# through `tailscale serve`. Anything else gets a 404 here and never reaches the Hub.
{$SQUERO_DOMAIN:localhost} {
	# The Hub parses the whole body before it checks the token: cap it here.
	request_body {
		max_size 1MB
	}
	@alerts {
		method POST
		path_regexp ^/contracts/[a-z0-9-]+/(alertmanager|grafana|pagerduty)$
	}
	handle @alerts {
		reverse_proxy hub:8080
	}
	@relay {
		method GET
		path /relay
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @relay {
		reverse_proxy hub:8080
	}
	@actuator {
		method GET POST
		path /actuator/desired /actuator/reports /actuator/blockers
	}
	handle @actuator {
		reverse_proxy hub:8080
	}
	handle {
		respond 404
	}
}
